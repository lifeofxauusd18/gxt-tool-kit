// X position (bar index) of the wick of candle `idx` inside a panel
f_candleWickX(int idx, int size, int offset) =>
    int tb = offset + (settings.width + settings.buffer) * (size - idx - 1)
    int(bar_index + settings.width / 2 + tb)
 
f_pushC123(CandleSet cs, int idx, int size, int offset, string txt, bool bull) =>
    Candle c = cs.candles.get(idx)
    float pad = math.max((c.h - c.l) * 0.03, syminfo.mintick * 2)
    float y = bull ? c.l - pad : c.h + pad
    cs.c123.push(label.new(f_candleWickX(idx, size, offset), y, txt, color = color_transparent, textcolor = in_c123Color, style = bull ? label.style_label_up : label.style_label_down, size = in_c123Size, text_formatting = text.format_bold))
    true
 
// C1 = swept candle, C2 = sweeping candle (newest sweep in the panel), C3 = continuation candle
method DrawC123(CandleSet cs, int offset) =>
    if not na(cs.c123)
        while cs.c123.size() > 0
            label.delete(cs.c123.pop())
    int size = cs.candles.size()
    if in_c123On and size >= 2
        int owner = -1
        for i = 0 to size - 2
            Candle cc = cs.candles.get(i)
            if not na(cc.sweep_lines) and cc.sweep_lines.size() > 0
                owner := i
                break
        if owner >= 0
            Candle c2 = cs.candles.get(owner)
            bool bull = c2.sweep_is_bullish.get(c2.sweep_lines.size() - 1)
            bool c2Alive = true
            if owner > 0
                for k = 0 to owner - 1
                    Candle newer = cs.candles.get(k)
                    if bull ? newer.l < c2.l : newer.h > c2.h
                        c2Alive := false
                        break
            if c2Alive
                f_pushC123(cs, owner + 1, size, offset, "C1", bull)
                f_pushC123(cs, owner, size, offset, "C2", bull)
                if owner >= 1
                    Candle c3 = cs.candles.get(owner - 1)
                    bool c3Valid = bull ? c3.h > c2.h : c3.l < c2.l
                    bool c3Alive = true
                    if owner >= 2
                        for k = 0 to owner - 2
                            Candle newer = cs.candles.get(k)
                            if bull ? newer.l < c3.l : newer.h > c3.h
                                c3Alive := false
                                break
                    if c3Valid and c3Alive
                        f_pushC123(cs, owner - 1, size, offset, "C3", bull)
    cs
 
method Reorder(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()
    if size > 0
        for i = size - 1 to 0 by 1
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (settings.width + settings.buffer) * (size - i - 1)
            box.set_left(candle.body, bar_index + t_buffer)
            box.set_right(candle.body, bar_index + settings.width + t_buffer)
            line.set_x1(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x1(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
 
            // HTF sweep lines: from C1's wick to C3's wick (or C2's right edge when there is no C3)
            if settings.sweep_show and not na(candle.sweep_lines) and candle.sweep_lines.size() > 0
                int c3WickX = int(bar_index + settings.width + t_buffer)
                if i > 0
                    int c3_t_buffer = offset + (settings.width + settings.buffer) * (size - (i - 1) - 1)
                    c3WickX := int(bar_index + settings.width / 2 + c3_t_buffer)
                if i + 1 < size
                    Candle c1Candle = candleSet.candles.get(i + 1)
                    int c1_t_buffer = offset + (settings.width + settings.buffer) * (size - (i + 1) - 1)
                    int c1WickX = int(bar_index + settings.width / 2 + c1_t_buffer)
                    for sweepIdx = candle.sweep_lines.size() - 1 to 0 by 1
                        line sweepLine = candle.sweep_lines.get(sweepIdx)
                        float c1Level = candle.sweep_c1_levels.get(sweepIdx)
                        if not na(sweepLine) and not na(c1Candle.body)
                            line.set_x1(sweepLine, c1WickX)
                            line.set_x2(sweepLine, c3WickX)
                            line.set_y1(sweepLine, c1Level)
                            line.set_y2(sweepLine, c1Level)
                else
                    clearAllHTFCandleSweeps(candle)
 
            // Panel SMT lines: from C1's wick to C2's wick (the candle that owns the SMT)
            if showPanelSmt and (not na(candle.smt_bear_line) or not na(candle.smt_bull_line))
                if i + 1 < size
                    int c2X = int(bar_index + settings.width / 2 + t_buffer)
                    int c1_tb = offset + (settings.width + settings.buffer) * (size - (i + 1) - 1)
                    int c1X = int(bar_index + settings.width / 2 + c1_tb)
                    int midX = int(math.round((c1X + c2X) / 2.0))
                    if not na(candle.smt_bear_line)
                        line.set_xy1(candle.smt_bear_line, c1X, candle.smt_bear_y1)
                        line.set_xy2(candle.smt_bear_line, c2X, candle.smt_bear_y2)
                        if not na(candle.smt_bear_lbl)
                            label.set_xy(candle.smt_bear_lbl, midX, (candle.smt_bear_y1 + candle.smt_bear_y2) / 2.0)
                    if not na(candle.smt_bull_line)
                        line.set_xy1(candle.smt_bull_line, c1X, candle.smt_bull_y1)
                        line.set_xy2(candle.smt_bull_line, c2X, candle.smt_bull_y2)
                        if not na(candle.smt_bull_lbl)
                            label.set_xy(candle.smt_bull_lbl, midX, (candle.smt_bull_y1 + candle.smt_bull_y2) / 2.0)
                else
                    clearCandlePanelSmt(candle)
    candleSet.DrawC123(offset)
    top = 0.0
    bottom = 0.0
    if settings.label_alignment == 'Align'
        top := f_allHigh(candleSet.candles)
        bottom := f_allLow(candleSet.candles, top)
    if settings.label_alignment == 'Follow Candles'
        top := candleSet.candles.CandleSetHigh(0)
        bottom := candleSet.candles.CandleSetLow(top)
    float lblPad = math.max(math.abs(top - bottom) * 0.06, syminfo.mintick * 12.0)
    top += lblPad
    bottom -= lblPad
    left = bar_index + offset + (settings.width + settings.buffer) * (size - 1) / 2
    if settings.htf_label_show
        string lblt = HTFName(candleSet.settings.htf)
        string lbll = lblt
        if settings.htf_timer_show
            lblt := lblt + '\n'
            lbll := '\n' + lbll
        string tmr = '(' + RemainingTime(candleSet.settings.htf) + ')'
        if settings.label_position == 'Both' or settings.label_position == 'Top'
            if not na(candleSet.tfNameTop)
                candleSet.tfNameTop.set_xy(left, top)
            else
                candleSet.tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size, text_formatting = text.format_bold)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerTop)
                    candleSet.tfTimerTop.set_xy(left, top)
                else
                    candleSet.tfTimerTop := label.new(left, top, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_down, size = settings.htf_timer_size, text_formatting = text.format_bold)
        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            if not na(candleSet.tfNameBottom)
                candleSet.tfNameBottom.set_xy(left, bottom)
            else
                candleSet.tfNameBottom := label.new(left, bottom, lbll, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size, text_formatting = text.format_bold)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerBottom)
                    candleSet.tfTimerBottom.set_xy(left, bottom)
                else
                    candleSet.tfTimerBottom := label.new(left, bottom, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_up, size = settings.htf_timer_size, text_formatting = text.format_bold)
    candleSet
 
method Monitor(CandleSet candleSet) =>
    int HTFBarTime = time(candleSet.settings.htf)
    isNewHTFCandle = ta.change(HTFBarTime) > 0
    if isNewHTFCandle
        Candle candle = Candle.new()
        candle.aH := array.new_float(4, na)
        candle.aL := array.new_float(4, na)
        candle.o := nz(candleSet.settings.own_o, open)
        candle.c := nz(candleSet.settings.own_c, close)
        candle.h := nz(candleSet.settings.own_h, high)
        candle.l := nz(candleSet.settings.own_l, low)
        candle.o_time := HTFBarTime
        candle.bar_idx := bar_index
        candle.high_bar_idx := bar_index
        candle.low_bar_idx := bar_index
        bull = candle.c > candle.o
        bool pspOn = false
        color bodyColor = f_opaque(pspOn and psp_style == 'Body' ? (candle.is_bullish_div ? psp_bull_div_body : psp_bear_div_body) : (bull ? settings.bull_body : settings.bear_body))
        color borderColor = pspOn and psp_style == 'Border' ? (candle.is_bullish_div ? psp_bull_div_body : psp_bear_div_body) : (bull ? settings.bull_border : settings.bear_border)
        color wickColor = bull ? settings.bull_wick : settings.bear_wick
        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), borderColor, 1, bgcolor = bodyColor)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = wickColor)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = wickColor)
        candle.sweep_lines := array.new<line>()
        candle.sweep_c1_indices := array.new<int>()
        candle.sweep_is_bullish := array.new<bool>()
        candle.sweep_c1_levels := array.new<float>()
        candleSet.candles.unshift(candle)
        candleSet.DetectCandleSetSweeps()
        candleSet.DetectPanelSmt()
        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            clearAllHTFCandleSweeps(delCandle)
            clearCandlePanelSmt(delCandle)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
    candleSet
 
method Update(CandleSet candleSet, int offset) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        bool isLiveCandle = candle.o_time == time(candleSet.settings.htf)
        if isLiveCandle
            candle.h := nz(candleSet.settings.own_h, math.max(candle.h, high))
            candle.l := nz(candleSet.settings.own_l, math.min(candle.l, low))
            candle.c := nz(candleSet.settings.own_c, close)
            if high >= candle.h - syminfo.mintick / 2
                candle.high_bar_idx := bar_index
            if low <= candle.l + syminfo.mintick / 2
                candle.low_bar_idx := bar_index
            bull = candle.c > candle.o
            candleSet.PSPRefresh(candle)
            bool pspOn = f_pspActive(candle)
            color bodyColor = f_opaque(pspOn and psp_style == 'Body' ? (candle.is_bullish_div ? psp_bull_div_body : psp_bear_div_body) : (bull ? settings.bull_body : settings.bear_body))
            color borderColor = pspOn and psp_style == 'Border' ? (candle.is_bullish_div ? psp_bull_div_body : psp_bear_div_body) : (bull ? settings.bull_border : settings.bear_border)
            color wickColor = bull ? settings.bull_wick : settings.bear_wick
            box.set_bgcolor(candle.body, bodyColor)
            box.set_border_color(candle.body, borderColor)
            line.set_color(candle.wick_up, wickColor)
            line.set_color(candle.wick_down, wickColor)
            box.set_top(candle.body, candle.o)
            box.set_bottom(candle.body, candle.c)
            line.set_y1(candle.wick_up, candle.h)
            line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
            line.set_y1(candle.wick_down, candle.l)
            line.set_y2(candle.wick_down, math.min(candle.o, candle.c))
 
        // HTF sweeps + panel SMT: detect as the live candle develops
        candleSet.DetectCandleSetSweeps()
        candleSet.DetectPanelSmt()
        if settings.sweep_show and settings.sweep_invalidate
            for candleIdx = 0 to candleSet.candles.size() - 1 by 1
                Candle sweepCandle = candleSet.candles.get(candleIdx)
                if not na(sweepCandle.sweep_lines) and sweepCandle.sweep_lines.size() > 0
                    for sweepIdx = sweepCandle.sweep_lines.size() - 1 to 0 by 1
                        bool isBullish = sweepCandle.sweep_is_bullish.get(sweepIdx)
                        float sweepLevel = sweepCandle.sweep_c1_levels.get(sweepIdx)
                        bool invalidated = isBullish ? (close < sweepLevel) : (close > sweepLevel)
                        if invalidated
                            line sweepLine = sweepCandle.sweep_lines.get(sweepIdx)
                            if not na(sweepLine)
                                line.delete(sweepLine)
                            sweepCandle.sweep_lines.remove(sweepIdx)
                            sweepCandle.sweep_c1_indices.remove(sweepIdx)
                            sweepCandle.sweep_is_bullish.remove(sweepIdx)
                            sweepCandle.sweep_c1_levels.remove(sweepIdx)
    candleSet
 
// Phase 1: update data only
f_panelRun(CandleSet s, int offset) =>
    s.UpdateTime(offset)
    s.Monitor().Update(offset)
    true
 
// Phase 2: position the panel
f_panelPlace(CandleSet s, int offset) =>
    if barstate.isrealtime or barstate.islast
        if s.candles.size() > 0
            s.Reorder(offset)
    true
 
// Sort key = timeframe length in seconds (slot index only breaks ties); na = panel not shown
f_panelKey(CandleSet s, int slot) =>
    s.settings.show and ValidTimeframe(s.settings.htf) ? timeframe.in_seconds(s.settings.htf) + slot * 0.001 : na
 
f_panelWidth(CandleSet s) =>
    int n = s.candles.size()
    n > 0 ? n * settings.width + (n - 1) * settings.buffer : 0
 
// Offset of panel `i` = padding + width of every shown panel with a shorter timeframe
f_panelOffset(int i, array<float> keys, array<int> ws) =>
    int off = settings.offset
    float mk = keys.get(i)
    for j = 0 to 5
        float kj = keys.get(j)
        if not na(kj) and kj < mk
            off += ws.get(j) + settings.htf_buffer
    off
 
