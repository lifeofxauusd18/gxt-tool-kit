// SMT between the newest panel candle (C2) and the previous one (C1):
// the chart and an asset disagree on whether C2 took C1's high (bearish) / low (bullish).
// The SMT line runs from C1's wick to C2's wick and stays after the candle closes.
method DetectPanelSmt(CandleSet cs) =>
    if showPanelSmt and cs.candles.size() >= 2
        Candle c2 = cs.candles.get(0)
        Candle c1 = cs.candles.get(1)
        if not na(c2.body) and not na(c1.body)
            bool chartTookHigh = c2.h > c1.h
            bool chartTookLow = c2.l < c1.l
            int validH = 0
            int divH = 0
            int validL = 0
            int divL = 0
            bool[] flagsH = array.new_bool(4, false)
            bool[] flagsL = array.new_bool(4, false)
            for k = 0 to 3
                float c2h = array.get(c2.aH, k)
                float c1h = array.get(c1.aH, k)
                if not na(c2h) and not na(c1h)
                    validH += 1
                    if chartTookHigh != (c2h > c1h)
                        divH += 1
                        array.set(flagsH, k, true)
                float c2l = array.get(c2.aL, k)
                float c1l = array.get(c1.aL, k)
                if not na(c2l) and not na(c1l)
                    validL += 1
                    if chartTookLow != (c2l < c1l)
                        divL += 1
                        array.set(flagsL, k, true)
            bool allMode = comparisonTriggerMode == "All enabled comparisons"
            bool bearSmt = showBearish and (allMode ? (validH > 0 and divH == validH) : divH > 0)
            bool bullSmt = showBullish and (allMode ? (validL > 0 and divL == validL) : divL > 0)
 
            if bearSmt
                string txt = f_labelLogo(cs.settings.htf, f_compSuffix(flagsH))
                c2.smt_bear_y1 := c1.h
                c2.smt_bear_y2 := c2.h
                if na(c2.smt_bear_line)
                    c2.smt_bear_line := line.new(bar_index, c2.smt_bear_y1, bar_index, c2.smt_bear_y2, color = panelSmtColor, width = lineWidth, style = f_lineStyle(lineStyleInput))
            else
                if not na(c2.smt_bear_line)
                    line.delete(c2.smt_bear_line)
                    c2.smt_bear_line := na
                if not na(c2.smt_bear_lbl)
                    label.delete(c2.smt_bear_lbl)
                    c2.smt_bear_lbl := na
 
            if bullSmt
                string txt = f_labelLogo(cs.settings.htf, f_compSuffix(flagsL))
                c2.smt_bull_y1 := c1.l
                c2.smt_bull_y2 := c2.l
                if na(c2.smt_bull_line)
                    c2.smt_bull_line := line.new(bar_index, c2.smt_bull_y1, bar_index, c2.smt_bull_y2, color = panelSmtColor, width = lineWidth, style = f_lineStyle(lineStyleInput))
            else
                if not na(c2.smt_bull_line)
                    line.delete(c2.smt_bull_line)
                    c2.smt_bull_line := na
                if not na(c2.smt_bull_lbl)
                    label.delete(c2.smt_bull_lbl)
                    c2.smt_bull_lbl := na
    cs
 
