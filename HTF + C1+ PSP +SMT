f_makeLabel(bool useIndexX, int x1Time, int x1Idx, float y1, int x2Time, int x2Idx, float y2, int dir, string txt, string tip, string labelSizeStr) =>
    int labelX = useIndexX ? int(math.round((x1Idx + x2Idx) / 2.0)) : int(math.round((x1Time + x2Time) / 2.0))
    float midY = (y1 + y2) / 2.0
    // Anchored exactly on the line midpoint (no floating offset); label style places text just above/below the line.
    float labelY = midY
    label_style = dir == -1 ? label.style_label_down : label.style_label_up
    label lb = na
    if useIndexX
        lb := label.new(labelX, labelY, txt, xloc=xloc.bar_index, color=labelBgColor, textcolor=labelTextColor, style=label_style, size=f_labelSize(labelSizeStr), textalign=text.align_center, text_font_family=font.family_monospace)
    else
        lb := label.new(labelX, labelY, txt, xloc=xloc.bar_time, color=labelBgColor, textcolor=labelTextColor, style=label_style, size=f_labelSize(labelSizeStr), textalign=text.align_center, text_font_family=font.family_monospace)
    label.set_tooltip(lb, tip)
    lb
 
f_updateLabel(label lb, bool useIndexX, int x1Time, int x1Idx, float y1, int x2Time, int x2Idx, float y2, int dir, string txt, string tip, string labelSizeStr) =>
    int labelX = useIndexX ? int(math.round((x1Idx + x2Idx) / 2.0)) : int(math.round((x1Time + x2Time) / 2.0))
    float midY = (y1 + y2) / 2.0
    // Anchored exactly on the line midpoint (no floating offset); label style places text just above/below the line.
