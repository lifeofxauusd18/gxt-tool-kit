// Fetches the HTF candle of every enabled asset.
method FetchAssets(CandleSet this, string htf) =>
    for k = 0 to 3
        bool has = false
        if array.get(useCmp, k)
            [ao, ah, al, ac] = request.security(array.get(cmpTickers, k), htf, [open, high, low, close], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
            array.set(this.aO, k, ao)
            array.set(this.aH, k, ah)
            array.set(this.aL, k, al)
            array.set(this.aC, k, ac)
            has := not na(ao) and not na(ah) and not na(al) and not na(ac)
        array.set(this.aHas, k, has)
    this
 
// Chart candle vs each enabled asset: opposite close direction = divergence
method DetectHTFDivergence(Candle candle, CandleSet this) =>
    bool chartBull = candle.c > candle.o
    bool chartBear = candle.c < candle.o
    int valid = 0
    int divs = 0
    for k = 0 to 3
        if array.get(this.aHas, k)
            valid += 1
            float ao = array.get(this.aO, k)
            float ac = array.get(this.aC, k)
            bool aBull = ac > ao
            bool aBear = ac < ao
            if (chartBull and aBear) or (chartBear and aBull)
                divs += 1
    bool anyDiv = valid > 0 and divs > 0
    bool allDiv = valid > 0 and divs == valid
    candle.has_divergence := comparisonTriggerMode == "All enabled comparisons" ? allDiv : anyDiv
    candle.is_bullish_div := chartBull
    candle
 
method DetectHTFPivots(Candle candle, CandleSet this, string htf) =>
    candle.is_psp := false
    if psp_mode == 'PSP'
        bool has_pivot_1 = false
        bool has_pivot_assets = false
        if this.candles.size() >= 3
            Candle prev1 = this.candles.get(1)
            Candle prev2 = this.candles.get(2)
            is_pivot_high = prev1.h > prev2.h and prev1.h > candle.h
            is_pivot_low = prev1.l < prev2.l and prev1.l < candle.l
            has_pivot_1 := is_pivot_high or is_pivot_low
        if not psp_precise_mode
            for k = 0 to 3
                if array.get(this.aHas, k)
                    [ph, pl] = request.security(array.get(cmpTickers, k), htf, [ta.pivothigh(high, 1, 1), ta.pivotlow(low, 1, 1)], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
                    if not na(ph) or not na(pl)
                        has_pivot_assets := true
        bool is_pivot = psp_precise_mode ? has_pivot_1 : (has_pivot_1 or has_pivot_assets)
        candle.is_psp := is_pivot and candle.has_divergence
    candle
 
// Re-fetches asset data, stores it on the candle (for panel SMT) and re-evaluates PSP
method PSPRefresh(CandleSet this, Candle candle) =>
    if needAssets
        this.FetchAssets(this.settings.htf)
        for k = 0 to 3
            bool has = array.get(this.aHas, k)
            array.set(candle.aH, k, has ? array.get(this.aH, k) : na)
            array.set(candle.aL, k, has ? array.get(this.aL, k) : na)
        if psp_on
            candle.DetectHTFDivergence(this).DetectHTFPivots(this, this.settings.htf)
    this
 
