// Comparison high/low on the current chart timeframe. Requests only execute when
// the comparison symbol is enabled, so disabled symbols cost nothing against
// TradingView's request.security limit.
f_cmpChart(string sym, bool on) =>
    float h = na
    float l = na
    if on
        [t, tc, ch, cl] = request.security(sym, timeframe.period, [time, time_close, high, low], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
        bool aligned = not na(t) and not na(tc) and t == time and tc == time_close
        if aligned and not na(ch) and not na(cl)
            h := ch
            l := cl
    [h, l]
 
// Previous closed candle high/low on a given timeframe. [1] + lookahead_on is safe
// because the requested candle is already closed.
f_prevHL(string sym, string tf, bool on) =>
    float h = na
    float l = na
    if on
        [ph, pl] = request.security(sym, tf, [high[1], low[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
        h := ph
        l := pl
    [h, l]
 
// Previous candle high/low of all four comparison symbols for one timeframe.
f_nativePrev4(string tf, bool tfOn) =>
    int sec = timeframe.in_seconds(tf)
    bool okTf = showChartSmt and tfOn and sec >= timeframe.in_seconds(timeframe.period) and (repairLtfPrev or sec > 3600)
    [h1, l1] = f_prevHL(comparisonTicker1, tf, okTf and useComparison1)
    [h2, l2] = f_prevHL(comparisonTicker2, tf, okTf and useComparison2)
    [h3, l3] = f_prevHL(comparisonTicker3, tf, okTf and useComparison3)
    [h4, l4] = f_prevHL(comparisonTicker4, tf, okTf and useComparison4)
    [h1, l1, h2, l2, h3, l3, h4, l4]
 
[cmp1HighChart, cmp1LowChart] = f_cmpChart(comparisonTicker1, useComparison1 and showChartSmt)
[cmp2HighChart, cmp2LowChart] = f_cmpChart(comparisonTicker2, useComparison2 and showChartSmt)
[cmp3HighChart, cmp3LowChart] = f_cmpChart(comparisonTicker3, useComparison3 and showChartSmt)
[cmp4HighChart, cmp4LowChart] = f_cmpChart(comparisonTicker4, useComparison4 and showChartSmt)
 
float[] cmpHNow = array.from(cmp1HighChart, cmp2HighChart, cmp3HighChart, cmp4HighChart)
float[] cmpLNow = array.from(cmp1LowChart, cmp2LowChart, cmp3LowChart, cmp4LowChart)
 
// Native previous Daily/Weekly reference candles of the chart symbol.
[chartDPrevH, chartDPrevL] = f_prevHL(syminfo.tickerid, tfD, tfD_on and showChartSmt)
[chartWPrevH, chartWPrevL] = f_prevHL(syminfo.tickerid, tfW, tfW_on and showChartSmt)
 
[pW1H, pW1L, pW2H, pW2L, pW3H, pW3L, pW4H, pW4L]       = f_nativePrev4(tfW,  tfW_on)
[pD1H, pD1L, pD2H, pD2L, pD3H, pD3L, pD4H, pD4L]       = f_nativePrev4(tfD,  tfD_on)
[p7H1H, p7H1L, p7H2H, p7H2L, p7H3H, p7H3L, p7H4H, p7H4L] = f_nativePrev4(tf7H, tf7H_on)
[p6H1H, p6H1L, p6H2H, p6H2L, p6H3H, p6H3L, p6H4H, p6H4L] = f_nativePrev4(tf6H, tf6H_on)
[p4H1H, p4H1L, p4H2H, p4H2L, p4H3H, p4H3L, p4H4H, p4H4L] = f_nativePrev4(tf4H, tf4H_on)
[p901H, p901L, p902H, p902L, p903H, p903L, p904H, p904L] = f_nativePrev4(tf90, tf90_on)
[p1H1H, p1H1L, p1H2H, p1H2L, p1H3H, p1H3L, p1H4H, p1H4L] = f_nativePrev4(tf1H, tf1H_on)
[p301H, p301L, p302H, p302L, p303H, p303L, p304H, p304L] = f_nativePrev4(tf30, tf30_on)
[p151H, p151L, p152H, p152L, p153H, p153L, p154H, p154L] = f_nativePrev4(tf15, tf15_on)
[p51H, p51L, p52H, p52L, p53H, p53L, p54H, p54L]       = f_nativePrev4(tf5,  tf5_on)
[p11H, p11L, p12H, p12L, p13H, p13L, p14H, p14L]       = f_nativePrev4(tf1,  tf1_on)
 
chartShort = f_shortSymbol(syminfo.ticker)
 
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CORE MTF PROCESSOR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Comparison data is stored in flat arrays: index k (0..3) = comparison symbol k+1.
// History arrays hold 4 consecutive entries per stored candle (slot * 4 + k).
f_processTF(bool enabled, string tf, int slotLookback, color tfColor, float[] cmpH, float[] cmpL, float nativePrevH, float nativePrevL, float[] nativePrevCmpH, float[] nativePrevCmpL) =>
    bool bearPrinted = false
    bool bullPrinted = false
    int tfSec = timeframe.in_seconds(tf)
    int chartSec = timeframe.in_seconds(timeframe.period)
    bool run = enabled and tfSec >= chartSec and showChartSmt
    int activeLookback = usePerTfLookbacks ? slotLookback : lookbackCandles
 
    var float curH = na
    var float curL = na
    var int   curHT = na
    var int   curLT = na
    var int   curHI = na
    var int   curLI = na
    var int   curStart = na
    var float[] curCmpH = array.new_float(4, na)
    var float[] curCmpL = array.new_float(4, na)
    var bool[]  curCmpValid = array.new_bool(4, false)
    var float[] hHist = array.new_float(0)
    var float[] lHist = array.new_float(0)
    var int[]   hTimeHist = array.new_int(0)
    var int[]   lTimeHist = array.new_int(0)
    var int[]   hIdxHist = array.new_int(0)
    var int[]   lIdxHist = array.new_int(0)
    var int[]   startHist = array.new_int(0)
    var float[] cmpHHist = array.new_float(0)
    var float[] cmpLHist = array.new_float(0)
 
    bool[] useC = array.from(useComparison1, useComparison2, useComparison3, useComparison4)
    int requiredComps = (useComparison1 ? 1 : 0) + (useComparison2 ? 1 : 0) + (useComparison3 ? 1 : 0) + (useComparison4 ? 1 : 0)
    bool anyComparisonMode = requiredComps > 0
 
    if run
        int thisStart = time(tf)
        if na(curStart)
            curStart := thisStart
            curH := high
            curL := low
            curHT := time
            curLT := time
            curHI := bar_index
            curLI := bar_index
            for k = 0 to 3
                float ch = array.get(cmpH, k)
                float cl = array.get(cmpL, k)
                array.set(curCmpH, k, ch)
                array.set(curCmpL, k, cl)
                array.set(curCmpValid, k, not na(ch) and not na(cl))
        else
            bool newTF = thisStart != curStart
            if newTF
                if not persistAfterClose
                    f_deleteEventsByTFStart(tf, curStart)
                array.unshift(hHist, curH)
                array.unshift(lHist, curL)
                array.unshift(hTimeHist, curHT)
                array.unshift(lTimeHist, curLT)
                array.unshift(hIdxHist, curHI)
                array.unshift(lIdxHist, curLI)
                array.unshift(startHist, curStart)
                for k = 3 to 0
                    bool v = array.get(curCmpValid, k)
                    array.unshift(cmpHHist, v ? array.get(curCmpH, k) : na)
                    array.unshift(cmpLHist, v ? array.get(curCmpL, k) : na)
                while array.size(hHist) > activeLookback + 10
                    array.pop(hHist)
                    array.pop(lHist)
                    array.pop(hTimeHist)
                    array.pop(lTimeHist)
                    array.pop(hIdxHist)
                    array.pop(lIdxHist)
                    array.pop(startHist)
                    for k = 0 to 3
                        if array.size(cmpHHist) > 0
                            array.pop(cmpHHist)
                            array.pop(cmpLHist)
                curStart := thisStart
                curH := high
                curL := low
                curHT := time
                curLT := time
                curHI := bar_index
                curLI := bar_index
                for k = 0 to 3
                    float ch = array.get(cmpH, k)
                    float cl = array.get(cmpL, k)
                    array.set(curCmpH, k, ch)
                    array.set(curCmpL, k, cl)
                    array.set(curCmpValid, k, not na(ch) and not na(cl))
            else
                if high > curH or na(curH)
                    curH := high
                    curHT := time
                    curHI := bar_index
                if low < curL or na(curL)
                    curL := low
                    curLT := time
                    curLI := bar_index
                // Preserve the original strict behavior on 1H and below in Clean mode.
                // For >1H (or non-Clean) keep any valid aligned samples we have.
                bool tolerantComparisonSampling = smtFilteringMode != "Clean" or tfSec > 60 * 60
                for k = 0 to 3
                    float ch = array.get(cmpH, k)
                    float cl = array.get(cmpL, k)
                    if not na(ch)
                        float oh = array.get(curCmpH, k)
                        array.set(curCmpH, k, na(oh) ? ch : math.max(oh, ch))
                    if not na(cl)
                        float ol = array.get(curCmpL, k)
                        array.set(curCmpL, k, na(ol) ? cl : math.min(ol, cl))
                    bool sampleValid = not na(ch) and not na(cl)
                    bool oldValid = array.get(curCmpValid, k)
                    array.set(curCmpValid, k, tolerantComparisonSampling ? (oldValid or sampleValid) : (oldValid and sampleValid))
 
        float minSweep = 0.0
        float dedupe = dedupeTicks * syminfo.mintick
        float endpointTol = math.max(syminfo.mintick, dedupe)
        string tfSize = f_tfSizeString(tf)
        float[] usedBearLevels = array.new_float(0)
        float[] usedBullLevels = array.new_float(0)
        int[] usedBearX = array.new_int(0)
        float[] usedBearY = array.new_float(0)
        int[] usedBullX = array.new_int(0)
        float[] usedBullY = array.new_float(0)
        float[] refCmpH = array.new_float(4, na)
        float[] refCmpL = array.new_float(4, na)
        bool[] divFlags = array.new_bool(4, false)
        int bearCount = 0
        int bullCount = 0
        int histSize = array.size(hHist)
        int lb = math.min(activeLookback, histSize)
 
        if lb > 0
            for refIdx = 0 to lb - 1
                float refH = array.get(hHist, refIdx)
                float refL = array.get(lHist, refIdx)
                int refHT = array.get(hTimeHist, refIdx)
                int refLT = array.get(lTimeHist, refIdx)
                int refHI = array.get(hIdxHist, refIdx)
                int refLI = array.get(lIdxHist, refIdx)
                int refStart = array.get(startHist, refIdx)
                for k = 0 to 3
                    int hi = refIdx * 4 + k
                    array.set(refCmpH, k, hi < array.size(cmpHHist) ? array.get(cmpHHist, hi) : na)
                    array.set(refCmpL, k, hi < array.size(cmpLHist) ? array.get(cmpLHist, hi) : na)
 
                // Adjacent-period repair on every timeframe using confirmed native [1] values.
                if refIdx == 0
                    if not na(nativePrevH) and not na(nativePrevL)
                        refH := nativePrevH
                        refL := nativePrevL
                    for k = 0 to 3
                        float nH = array.get(nativePrevCmpH, k)
                        float nL = array.get(nativePrevCmpL, k)
                        if array.get(useC, k) and not na(nH) and not na(nL)
                            array.set(refCmpH, k, nH)
                            array.set(refCmpL, k, nL)
 
                bool untouchedHigh = true
                bool untouchedLow = true
                if refIdx > 0
                    for checkIdx = 0 to refIdx - 1
                        if array.get(hHist, checkIdx) >= refH
                            untouchedHigh := false
                        if array.get(lHist, checkIdx) <= refL
                            untouchedLow := false
 
                bool swingHigh = f_localSwingHigh(refIdx, refH, hHist, endpointTol)
                bool swingLow = f_localSwingLow(refIdx, refL, lHist, endpointTol)
                bool validHigh = smtFilteringMode == "Clean" ? untouchedHigh : smtFilteringMode == "Full" ? true : (untouchedHigh or swingHigh)
                bool validLow = smtFilteringMode == "Clean" ? untouchedLow : smtFilteringMode == "Full" ? true : (untouchedLow or swingLow)
 
                bool endpointBearUsed = smtFilteringMode == "Clean" and f_endpointAlreadyUsed(usedBearX, usedBearY, curHT, curH, endpointTol)
                if showBearish and validHigh and bearCount < maxPerDirection and not endpointBearUsed and not f_levelAlreadyUsed(usedBearLevels, refH, dedupe)
                    bool chartTookHigh = curH > refH + minSweep
                    int validComps = 0
                    int divCount = 0
                    for k = 0 to 3
                        float cH = array.get(curCmpH, k)
                        float rH = array.get(refCmpH, k)
                        bool have = array.get(useC, k) and array.get(curCmpValid, k) and not na(cH) and not na(rH)
                        bool took = have and cH > rH + minSweep
                        bool div = have and chartTookHigh != took
                        array.set(divFlags, k, div)
                        if have
                            validComps += 1
                        if div
                            divCount += 1
                    bool eitherDiv = validComps > 0 and divCount > 0
                    bool allDiv = requiredComps > 0 and validComps == requiredComps and divCount == requiredComps
                    bool isBear = anyComparisonMode ? (comparisonTriggerMode == "All enabled comparisons" ? allDiv : eitherDiv) : false
                    bool closeOk = not requireCloseBack or close < refH
                    if isBear and closeOk
                        string suffix = anyComparisonMode ? f_compSuffix(divFlags) : f_logoSymbol(syminfo.ticker)
                        if str.length(suffix) == 0
                            suffix := f_enabledCompSuffix()
                        string txt = f_labelLogo(tf, suffix)
                        string tip = anyComparisonMode ? "Bearish SMT vs " + suffix : chartShort + " swept its own HTF high."
                        float y1 = refH
                        float y2 = curH
                        int x1Time = refHT
                        int x2Time = curHT
                        int x1Idx = refHI
                        int x2Idx = curHI
                        float anchor = chartTookHigh ? curH : refH
                        string key = tf + "|BEAR|" + str.tostring(refStart) + "|" + str.tostring(curStart)
                        bool drawn = f_drawOrUpdate(key, tf, tfSec, -1, refStart, curStart, x1Time, x1Idx, y1, x2Time, x2Idx, y2, anchor, txt, tip, endpointTol, tfSize, tfColor)
                        if drawn
                            bearPrinted := true
                            bearCount += 1
                            array.push(usedBearLevels, refH)
                            array.push(usedBearY, curH)
                            array.push(usedBearX, curHT)
 
                bool endpointBullUsed = smtFilteringMode == "Clean" and f_endpointAlreadyUsed(usedBullX, usedBullY, curLT, curL, endpointTol)
                if showBullish and validLow and bullCount < maxPerDirection and not endpointBullUsed and not f_levelAlreadyUsed(usedBullLevels, refL, dedupe)
                    bool chartTookLow = curL < refL - minSweep
                    int validComps = 0
                    int divCount = 0
                    for k = 0 to 3
                        float cL = array.get(curCmpL, k)
                        float rL = array.get(refCmpL, k)
                        bool have = array.get(useC, k) and array.get(curCmpValid, k) and not na(cL) and not na(rL)
                        bool took = have and cL < rL - minSweep
                        bool div = have and chartTookLow != took
                        array.set(divFlags, k, div)
                        if have
                            validComps += 1
                        if div
                            divCount += 1
                    bool eitherDiv = validComps > 0 and divCount > 0
                    bool allDiv = requiredComps > 0 and validComps == requiredComps and divCount == requiredComps
                    bool isBull = anyComparisonMode ? (comparisonTriggerMode == "All enabled comparisons" ? allDiv : eitherDiv) : false
                    bool closeOk = not requireCloseBack or close > refL
                    if isBull and closeOk
                        string suffix = anyComparisonMode ? f_compSuffix(divFlags) : f_logoSymbol(syminfo.ticker)
                        if str.length(suffix) == 0
                            suffix := f_enabledCompSuffix()
                        string txt = f_labelLogo(tf, suffix)
                        string tip = anyComparisonMode ? "Bullish SMT vs " + suffix : chartShort + " swept its own HTF low."
                        float y1 = refL
                        float y2 = curL
                        int x1Time = refLT
                        int x2Time = curLT
                        int x1Idx = refLI
                        int x2Idx = curLI
                        float anchor = chartTookLow ? curL : refL
                        string key = tf + "|BULL|" + str.tostring(refStart) + "|" + str.tostring(curStart)
                        bool drawn = f_drawOrUpdate(key, tf, tfSec, 1, refStart, curStart, x1Time, x1Idx, y1, x2Time, x2Idx, y2, anchor, txt, tip, endpointTol, tfSize, tfColor)
                        if drawn
                            bullPrinted := true
                            bullCount += 1
                            array.push(usedBullLevels, refL)
                            array.push(usedBullY, curL)
                            array.push(usedBullX, curLT)
 
        f_deleteUnseenCurrentTF(tf, curStart)
    else
        // Prevent drawings from a disabled slot or a timeframe below the chart
        // timeframe from remaining on the chart after settings/timeframe changes.
        f_deleteAllEventsByTF(tf)
 
    [bearPrinted, bullPrinted]
 
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PROCESS HIGH TF → LOW TF
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[bW,  uW]  = f_processTF(tfW_on,  tfW,  lookbackW,  colW,  cmpHNow, cmpLNow, chartWPrevH, chartWPrevL, array.from(pW1H, pW2H, pW3H, pW4H), array.from(pW1L, pW2L, pW3L, pW4L))
[bD,  uD]  = f_processTF(tfD_on,  tfD,  lookbackD,  colD,  cmpHNow, cmpLNow, chartDPrevH, chartDPrevL, array.from(pD1H, pD2H, pD3H, pD4H), array.from(pD1L, pD2L, pD3L, pD4L))
[b7H, u7H] = f_processTF(tf7H_on, tf7H, lookback7H, col7H, cmpHNow, cmpLNow, na, na, array.from(p7H1H, p7H2H, p7H3H, p7H4H), array.from(p7H1L, p7H2L, p7H3L, p7H4L))
[b6H, u6H] = f_processTF(tf6H_on, tf6H, lookback6H, col6H, cmpHNow, cmpLNow, na, na, array.from(p6H1H, p6H2H, p6H3H, p6H4H), array.from(p6H1L, p6H2L, p6H3L, p6H4L))
