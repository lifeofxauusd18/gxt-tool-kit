// Converts a friendly label ("90m", "6H", "7H", "1D", "1W") into a Pine timeframe string.
f_labelToTf(string s) =>
    string out = s
    if str.endswith(s, "m")
        out := str.replace(s, "m", "")
    else if str.endswith(s, "H")
        out := str.tostring(int(str.tonumber(str.replace(s, "H", "")) * 60))
    out
 
