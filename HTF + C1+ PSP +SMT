// DRAWING STATE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
type SMTDraw
    string key
    string tf
    int    tfSec
    int    dir
    int    refStart
    int    curStart
    int    lastSeenBar
    float  anchor
    int    x1Time
    int    x2Time
