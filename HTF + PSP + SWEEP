// Unknown symbols return empty secondary/tertiary -> no PSP; use the Manual preset for those.
f_resolveChart() =>
    string t = str.upper(syminfo.root)
    string s2 = ''
    string s3 = ''
    bool i2 = false
    bool i3 = false
    if t == 'NQ' or t == 'MNQ'
        s2 := 'CME_MINI:ES1!'
        s3 := 'CBOT_MINI:YM1!'
    else if t == 'ES' or t == 'MES'
        s2 := 'CME_MINI:NQ1!'
        s3 := 'CBOT_MINI:YM1!'
    else if t == 'YM' or t == 'MYM'
        s2 := 'CME_MINI:ES1!'
        s3 := 'CME_MINI:NQ1!'
    else if t == 'NAS100USD' or t == 'US100'
        s2 := 'OANDA:SPX500USD'
        s3 := 'OANDA:US30USD'
    else if t == 'SPX500USD' or t == 'US500'
        s2 := 'OANDA:NAS100USD'
        s3 := 'OANDA:US30USD'
    else if t == 'US30USD' or t == 'US30'
        s2 := 'OANDA:SPX500USD'
        s3 := 'OANDA:NAS100USD'
    else if t == 'EURUSD' or t == '6E'
        s2 := 'OANDA:GBPUSD'
        s3 := 'TVC:DXY'
        i3 := true
    else if t == 'GBPUSD' or t == '6B'
        s2 := 'OANDA:EURUSD'
        s3 := 'TVC:DXY'
        i3 := true
    else if t == 'DXY'
        s2 := 'OANDA:EURUSD'
        s3 := 'OANDA:GBPUSD'
        i2 := true
        i3 := true
    else if t == 'XAUUSD' or t == 'GC' or t == 'MGC'
        s2 := 'COMEX:SI1!'
        s3 := 'TVC:DXY'
        i3 := true
    else if t == 'XAGUSD' or t == 'SI'
        s2 := 'COMEX:GC1!'
        s3 := 'TVC:DXY'
        i3 := true
    else if t == 'BTCUSD' or t == 'BTCUSDT'
        s2 := 'BITSTAMP:ETHUSD'
    else if t == 'ETHUSD' or t == 'ETHUSDT'
        s2 := 'BITSTAMP:BTCUSD'
    AssetConfig.new(syminfo.tickerid, s2, s3, i2, i3)
 
isValidSymbol(string sym) =>
    not na(sym) and str.length(sym) > 0
 
method InitAssets(CandleSet this) =>
    this.asset1 := AssetData.new()
    this.asset2 := AssetData.new()
    this.asset3 := AssetData.new()
    this
 
method SetAssetIncludes(CandleSet this) =>
    this.asset1.include := true
    this.asset2.include := this.asset2.symbol != ''
    this.asset3.include := this.asset3.symbol != ''
    this
 
method ApplyAutoAssets(CandleSet this, AssetConfig config) =>
    this.asset1.symbol := config.primary
    this.asset2.symbol := isValidSymbol(config.secondary) ? config.secondary : ''
    this.asset3.symbol := isValidSymbol(config.tertiary) ? config.tertiary : ''
    this.asset2.invert := config.invertSecondary
    this.asset3.invert := config.invertTertiary
    this
 
method FetchHTFOHLC(CandleSet this, string htf, Candle htfCandle) =>
    if this.asset1.symbol != '' and this.asset1.include
        this.asset1.data_open := htfCandle.o
        this.asset1.data_close := htfCandle.c
        this.asset1.data_high := htfCandle.h
        this.asset1.data_low := htfCandle.l
        this.asset1.has_data := true
    if this.asset2.symbol != '' and this.asset2.include
        [o2, h2, l2, c2] = request.security(this.asset2.symbol, htf, [open, high, low, close], lookahead = barmerge.lookahead_on)
        this.asset2.data_open := o2
        this.asset2.data_close := c2
        this.asset2.data_high := h2
        this.asset2.data_low := l2
        this.asset2.has_data := not na(o2)
    if this.asset3.symbol != '' and this.asset3.include
        [o3, h3, l3, c3] = request.security(this.asset3.symbol, htf, [open, high, low, close], lookahead = barmerge.lookahead_on)
        this.asset3.data_open := o3
        this.asset3.data_close := c3
        this.asset3.data_high := h3
        this.asset3.data_low := l3
        this.asset3.has_data := not na(o3)
    this
 
method CalculateHTFBullishBearish(CandleSet this) =>
    if this.asset1.has_data
        this.asset1.bullish := this.asset1.invert ? this.asset1.data_close < this.asset1.data_open : this.asset1.data_close > this.asset1.data_open
        this.asset1.bearish := this.asset1.invert ? this.asset1.data_close > this.asset1.data_open : this.asset1.data_close < this.asset1.data_open
    if this.asset2.has_data
        this.asset2.bullish := this.asset2.invert ? this.asset2.data_close < this.asset2.data_open : this.asset2.data_close > this.asset2.data_open
        this.asset2.bearish := this.asset2.invert ? this.asset2.data_close > this.asset2.data_open : this.asset2.data_close < this.asset2.data_open
    if this.asset3.has_data
        this.asset3.bullish := this.asset3.invert ? this.asset3.data_close < this.asset3.data_open : this.asset3.data_close > this.asset3.data_open
        this.asset3.bearish := this.asset3.invert ? this.asset3.data_close > this.asset3.data_open : this.asset3.data_close < this.asset3.data_open
    this
 
method DetectHTFDivergence(Candle candle, CandleSet this) =>
    candle.divergence12 := this.asset2.has_data and ((this.asset1.bullish and this.asset2.bearish) or (this.asset1.bearish and this.asset2.bullish))
    candle.divergence13 := this.asset3.has_data and ((this.asset1.bullish and this.asset3.bearish) or (this.asset1.bearish and this.asset3.bullish))
    candle.divergence23 := this.asset2.has_data and this.asset3.has_data and ((this.asset2.bullish and this.asset3.bearish) or (this.asset2.bearish and this.asset3.bullish))
    candle.has_divergence := candle.divergence12 or candle.divergence13 or candle.divergence23
    candle.is_bullish_div := this.asset1.bullish
    candle
 
method DetectHTFPivots(Candle candle, CandleSet this, string htf) =>
    bool has_pivot_1 = false
    bool has_pivot_2 = false
    bool has_pivot_3 = false
 
    if this.candles.size() >= 3
        Candle prev1 = this.candles.get(1)
        Candle prev2 = this.candles.get(2)
        is_pivot_high = prev1.h > prev2.h and prev1.h > candle.h
        is_pivot_low = prev1.l < prev2.l and prev1.l < candle.l
        has_pivot_1 := is_pivot_high or is_pivot_low
 
    if this.asset2.has_data
        pivothigh_2 = request.security(this.asset2.symbol, htf, ta.pivothigh(high, 1, 1), lookahead = barmerge.lookahead_on)
        pivotlow_2 = request.security(this.asset2.symbol, htf, ta.pivotlow(low, 1, 1), lookahead = barmerge.lookahead_on)
        has_pivot_2 := not na(pivothigh_2) or not na(pivotlow_2)
 
    if this.asset3.has_data
        pivothigh_3 = request.security(this.asset3.symbol, htf, ta.pivothigh(high, 1, 1), lookahead = barmerge.lookahead_on)
        pivotlow_3 = request.security(this.asset3.symbol, htf, ta.pivotlow(low, 1, 1), lookahead = barmerge.lookahead_on)
        has_pivot_3 := not na(pivothigh_3) or not na(pivotlow_3)
 
    is_pivot = this.div_settings.precise_mode ? has_pivot_1 : (has_pivot_1 or has_pivot_2 or has_pivot_3)
    candle.is_psp := is_pivot and candle.has_divergence
    candle
 
// Re-evaluates divergence / PSP for one candle
method PSPRefresh(CandleSet this, Candle candle) =>
    if this.div_settings.preset != 'Off'
        if this.div_settings.preset == 'Manual'
            this.asset2.symbol := this.div_settings.manual_asset2
            this.asset3.symbol := this.div_settings.manual_asset3
        this.FetchHTFOHLC(this.settings.htf, candle).CalculateHTFBullishBearish()
        candle.DetectHTFDivergence(this).DetectHTFPivots(this, this.settings.htf)
    this
 
method PSPActive(CandleSet this, Candle candle) =>
    this.div_settings.preset != 'Off' and (this.div_settings.mode == 'PSP' ? candle.is_psp : candle.has_divergence)
 
clearAllHTFCandleSweeps(Candle candle) =>
    if not na(candle.sweep_lines) and candle.sweep_lines.size() > 0
        for i = candle.sweep_lines.size() - 1 to 0 by 1
            line l = candle.sweep_lines.get(i)
            if not na(l)
                line.delete(l)
        candle.sweep_lines.clear()
        candle.sweep_c1_indices.clear()
        candle.sweep_is_bullish.clear()
        candle.sweep_c1_levels.clear()
    true
 
// C2 (newest candle, index 0) sweeps C1 (index 1): takes its low/high and closes back inside.
// If C2 took BOTH sides of C1, the side that was hit first (by bar) is the one that gets marked.
method DetectCandleSetSweeps(CandleSet candleSet) =>
    if candleSet.candles.size() >= 2 and settings.sweep_show
        Candle c2 = candleSet.candles.get(0)
        Candle c1 = candleSet.candles.get(1)
        bool bullishSweep = c2.l < c1.l and c2.c > c1.l
        bool bearishSweep = c2.h > c1.h and c2.c < c1.h
        if bullishSweep and bearishSweep
            if c2.high_bar_idx <= c2.low_bar_idx
                bullishSweep := false
            else
                bearishSweep := false
        if (bullishSweep or bearishSweep) and not na(c1.body) and not na(c2.body)
            float yLevel = bullishSweep ? c1.l : c1.h
            bool alreadyHasSweep = false
            if not na(c2.sweep_lines) and c2.sweep_lines.size() > 0
                for i = c2.sweep_lines.size() - 1 to 0 by 1
                    if c2.sweep_c1_indices.get(i) == c1.bar_idx
                        if c2.sweep_c1_levels.get(i) == yLevel
                            alreadyHasSweep := true
                        else
                            line oldLine = c2.sweep_lines.get(i)
                            if not na(oldLine)
                                line.delete(oldLine)
                            c2.sweep_lines.remove(i)
                            c2.sweep_c1_indices.remove(i)
                            c2.sweep_is_bullish.remove(i)
                            c2.sweep_c1_levels.remove(i)
            if not alreadyHasSweep
                int x1 = box.get_left(c1.body) + 1
                int x2 = box.get_right(c2.body)
                line sweepLine = line.new(x1, yLevel, x2, yLevel, color = settings.sweep_color, style = f_lineStyle(settings.sweep_style), width = settings.sweep_width)
                c2.sweep_lines.push(sweepLine)
                c2.sweep_c1_indices.push(c1.bar_idx)
                c2.sweep_is_bullish.push(bullishSweep)
                c2.sweep_c1_levels.push(yLevel)
    candleSet
 
// ═════════════ PANEL METHODS ═════════════
method UpdateTime(CandleSet candleSet, int offset) =>
    if settings.htf_timer_show and (barstate.isrealtime or barstate.islast)
        string tmr = '(' + RemainingTime(candleSet.settings.htf) + ')'
        if not na(candleSet.tfTimerTop)
            candleSet.tfTimerTop.set_text(tmr)
        if not na(candleSet.tfTimerBottom)
            candleSet.tfTimerBottom.set_text(tmr)
    candleSet
 
method Reorder(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()
    if size > 0
        for i = size - 1 to 0 by 1
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (settings.width + settings.buffer) * (size - i - 1)
            box.set_left(candle.body, bar_index + t_buffer)
            box.set_right(candle.body, bar_index + settings.width + t_buffer)
            line.set_x1(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x1(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
 
            // HTF sweep lines: from C1's wick to C3's wick (or C2's right edge when there is no C3)
            if settings.sweep_show and not na(candle.sweep_lines) and candle.sweep_lines.size() > 0
                int c3WickX = int(bar_index + settings.width + t_buffer)
                if i > 0
                    int c3_t_buffer = offset + (settings.width + settings.buffer) * (size - (i - 1) - 1)
                    c3WickX := int(bar_index + settings.width / 2 + c3_t_buffer)
                if i + 1 < size
                    Candle c1Candle = candleSet.candles.get(i + 1)
                    int c1_t_buffer = offset + (settings.width + settings.buffer) * (size - (i + 1) - 1)
                    int c1WickX = int(bar_index + settings.width / 2 + c1_t_buffer)
                    for sweepIdx = candle.sweep_lines.size() - 1 to 0 by 1
                        line sweepLine = candle.sweep_lines.get(sweepIdx)
                        float c1Level = candle.sweep_c1_levels.get(sweepIdx)
                        if not na(sweepLine) and not na(c1Candle.body)
                            line.set_x1(sweepLine, c1WickX)
                            line.set_x2(sweepLine, c3WickX)
                            line.set_y1(sweepLine, c1Level)
                            line.set_y2(sweepLine, c1Level)
                else
                    clearAllHTFCandleSweeps(candle)
    top = 0.0
    bottom = 0.0
    if settings.label_alignment == 'Align'
        top := f_allHigh(candleSet.candles)
        bottom := f_allLow(candleSet.candles, top)
    if settings.label_alignment == 'Follow Candles'
        top := candleSet.candles.CandleSetHigh(0)
        bottom := candleSet.candles.CandleSetLow(top)
    float lblPad = math.max(math.abs(top - bottom) * 0.06, syminfo.mintick * 12.0)
    top += lblPad
    bottom -= lblPad
    left = bar_index + offset + (settings.width + settings.buffer) * (size - 1) / 2
    if settings.htf_label_show
        string lblt = HTFName(candleSet.settings.htf)
        string lbll = lblt
        if settings.htf_timer_show
            lblt := lblt + '\n'
            lbll := '\n' + lbll
        string tmr = '(' + RemainingTime(candleSet.settings.htf) + ')'
        if settings.label_position == 'Both' or settings.label_position == 'Top'
            if not na(candleSet.tfNameTop)
                candleSet.tfNameTop.set_xy(left, top)
            else
                candleSet.tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size, text_formatting = text.format_bold)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerTop)
                    candleSet.tfTimerTop.set_xy(left, top)
                else
                    candleSet.tfTimerTop := label.new(left, top, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_down, size = settings.htf_timer_size, text_formatting = text.format_bold)
        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            if not na(candleSet.tfNameBottom)
                candleSet.tfNameBottom.set_xy(left, bottom)
            else
                candleSet.tfNameBottom := label.new(left, bottom, lbll, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size, text_formatting = text.format_bold)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerBottom)
                    candleSet.tfTimerBottom.set_xy(left, bottom)
                else
                    candleSet.tfTimerBottom := label.new(left, bottom, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_up, size = settings.htf_timer_size, text_formatting = text.format_bold)
    candleSet
 
method Monitor(CandleSet candleSet) =>
    int HTFBarTime = time(candleSet.settings.htf)
    isNewHTFCandle = ta.change(HTFBarTime) > 0
    if isNewHTFCandle
        Candle candle = Candle.new()
        candle.o := nz(candleSet.settings.own_o, open)
        candle.c := nz(candleSet.settings.own_c, close)
        candle.h := nz(candleSet.settings.own_h, high)
        candle.l := nz(candleSet.settings.own_l, low)
        candle.o_time := HTFBarTime
        candle.bar_idx := bar_index
        candle.high_bar_idx := bar_index
        candle.low_bar_idx := bar_index
        bull = candle.c > candle.o
        candleSet.PSPRefresh(candle)
        bool pspOn = candleSet.PSPActive(candle)
        color bodyColor = f_opaque(pspOn and psp_style == 'Body' ? (candle.is_bullish_div ? psp_bull_div_body : psp_bear_div_body) : (bull ? settings.bull_body : settings.bear_body))
        color borderColor = pspOn and psp_style == 'Border' ? (candle.is_bullish_div ? psp_bull_div_body : psp_bear_div_body) : (bull ? settings.bull_border : settings.bear_border)
        color wickColor = bull ? settings.bull_wick : settings.bear_wick
        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), borderColor, 1, bgcolor = bodyColor)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = wickColor)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = wickColor)
        candle.sweep_lines := array.new<line>()
        candle.sweep_c1_indices := array.new<int>()
        candle.sweep_is_bullish := array.new<bool>()
        candle.sweep_c1_levels := array.new<float>()
        candleSet.candles.unshift(candle)
        candleSet.DetectCandleSetSweeps()
        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            clearAllHTFCandleSweeps(delCandle)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
    candleSet
 
method Update(CandleSet candleSet, int offset) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        bool isLiveCandle = candle.o_time == time(candleSet.settings.htf)
        if isLiveCandle
            candle.h := nz(candleSet.settings.own_h, math.max(candle.h, high))
            candle.l := nz(candleSet.settings.own_l, math.min(candle.l, low))
            candle.c := nz(candleSet.settings.own_c, close)
            if high >= candle.h - syminfo.mintick / 2
                candle.high_bar_idx := bar_index
            if low <= candle.l + syminfo.mintick / 2
                candle.low_bar_idx := bar_index
            bull = candle.c > candle.o
            if candleSet.div_settings.faster_detection
                candleSet.PSPRefresh(candle)
            bool pspOn = candleSet.PSPActive(candle)
            color bodyColor = f_opaque(pspOn and psp_style == 'Body' ? (candle.is_bullish_div ? psp_bull_div_body : psp_bear_div_body) : (bull ? settings.bull_body : settings.bear_body))
            color borderColor = pspOn and psp_style == 'Border' ? (candle.is_bullish_div ? psp_bull_div_body : psp_bear_div_body) : (bull ? settings.bull_border : settings.bear_border)
            color wickColor = bull ? settings.bull_wick : settings.bear_wick
            box.set_bgcolor(candle.body, bodyColor)
            box.set_border_color(candle.body, borderColor)
            line.set_color(candle.wick_up, wickColor)
            line.set_color(candle.wick_down, wickColor)
            box.set_top(candle.body, candle.o)
            box.set_bottom(candle.body, candle.c)
            line.set_y1(candle.wick_up, candle.h)
            line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
            line.set_y1(candle.wick_down, candle.l)
            line.set_y2(candle.wick_down, math.min(candle.o, candle.c))
 
        // HTF sweeps: detect as the live candle develops, drop levels price has closed back through
        candleSet.DetectCandleSetSweeps()
        if settings.sweep_show and settings.sweep_invalidate
            for candleIdx = 0 to candleSet.candles.size() - 1 by 1
                Candle sweepCandle = candleSet.candles.get(candleIdx)
                if not na(sweepCandle.sweep_lines) and sweepCandle.sweep_lines.size() > 0
                    for sweepIdx = sweepCandle.sweep_lines.size() - 1 to 0 by 1
                        bool isBullish = sweepCandle.sweep_is_bullish.get(sweepIdx)
                        float sweepLevel = sweepCandle.sweep_c1_levels.get(sweepIdx)
                        bool invalidated = isBullish ? (close < sweepLevel) : (close > sweepLevel)
                        if invalidated
                            line sweepLine = sweepCandle.sweep_lines.get(sweepIdx)
                            if not na(sweepLine)
                                line.delete(sweepLine)
                            sweepCandle.sweep_lines.remove(sweepIdx)
                            sweepCandle.sweep_c1_indices.remove(sweepIdx)
                            sweepCandle.sweep_is_bullish.remove(sweepIdx)
                            sweepCandle.sweep_c1_levels.remove(sweepIdx)
    candleSet
 
// Phase 1: update data only
f_panelRun(CandleSet s, int offset) =>
    s.UpdateTime(offset)
    s.Monitor().Update(offset)
    true
 
// Phase 2: position the panel
f_panelPlace(CandleSet s, int offset) =>
    if barstate.isrealtime or barstate.islast
        if s.candles.size() > 0
            s.Reorder(offset)
    true
 
// Sort key = timeframe length in seconds (slot index only breaks ties); na = panel not shown
f_panelKey(CandleSet s, int slot) =>
    s.settings.show and ValidTimeframe(s.settings.htf) ? timeframe.in_seconds(s.settings.htf) + slot * 0.001 : na
 
f_panelWidth(CandleSet s) =>
    int n = s.candles.size()
    n > 0 ? n * settings.width + (n - 1) * settings.buffer : 0
 
// Offset of panel `i` = padding + width of every shown panel with a shorter timeframe
f_panelOffset(int i, array<float> keys, array<int> ws) =>
    int off = settings.offset
    float mk = keys.get(i)
    for j = 0 to 5
        float kj = keys.get(j)
        if not na(kj) and kj < mk
            off += ws.get(j) + settings.htf_buffer
    off
 
// ═════════════ HTF DATA ═════════════
// Accumulates one HTF candle (open / close / high / low) from chart-timeframe values.
f_htfOHLC(string tf, float o_, float c_, float h_, float l_) =>
    var float ro = na
    var float rc = na
    var float rh = na
    var float rl = na
    var int   rt = na
    int t = time(tf)
    if not na(t)
        if na(rt) or t != rt
            ro := o_
            rh := h_
            rl := l_
            rt := t
        else
            if na(ro)
                ro := o_
            if not na(h_)
                rh := na(rh) ? h_ : math.max(rh, h_)
            if not na(l_)
                rl := na(rl) ? l_ : math.min(rl, l_)
        if not na(c_)
            rc := c_
    [ro, rc, rh, rl, na(ro) ? int(na) : rt]
 
f_loadHtfData(CandleSet s, string tf) =>
    [oO, oC, oH, oL, oT] = f_htfOHLC(tf, open, close, high, low)
    s.settings.own_o := oO
    s.settings.own_c := oC
    s.settings.own_h := oH
    s.settings.own_l := oL
    true
 
