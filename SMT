indicator("GxT SMT + Multi-TF SSMT (4 Assets)", shorttitle="GxT SMT", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════
// 0. INPUTS
// ═══════════════════════════════════════════════════════════════
