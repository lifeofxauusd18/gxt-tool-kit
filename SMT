// Comparison high/low on the current chart timeframe. Requests only execute when
// the comparison symbol is enabled, so disabled symbols cost nothing against
// TradingView's request.security limit.
f_cmpChart(string sym, bool on) =>
    float h = na
    float l = na
    if on
        [t, tc, ch, cl] = request.security(sym, timeframe.period, [time, time_close, high, low], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
        bool aligned = not na(t) and not na(tc) and t == time and tc == time_close
