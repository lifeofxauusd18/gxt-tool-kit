showSSMT = input.bool(true, "Show SSMT", group=G_Q)
en1  = input.bool(true,  "TF 1",  group=G_Q, inline="t1")
rawTf1 = input.string("15m", "", options=["1m","3m","5m","15m","30m","45m","90m","1h","2h","3h","4h","6h","7h","8h","12h","1D","1W","1M"], group=G_Q, inline="t1")
en2  = input.bool(true,  "TF 2",  group=G_Q, inline="t2")
rawTf2 = input.string("30m", "", options=["1m","3m","5m","15m","30m","45m","90m","1h","2h","3h","4h","6h","7h","8h","12h","1D","1W","1M"], group=G_Q, inline="t2")
en3  = input.bool(true,  "TF 3",  group=G_Q, inline="t3")
rawTf3 = input.string("90m", "", options=["1m","3m","5m","15m","30m","45m","90m","1h","2h","3h","4h","6h","7h","8h","12h","1D","1W","1M"], group=G_Q, inline="t3")
en4  = input.bool(true,  "TF 4",  group=G_Q, inline="t4")
rawTf4 = input.string("1h", "", options=["1m","3m","5m","15m","30m","45m","90m","1h","2h","3h","4h","6h","7h","8h","12h","1D","1W","1M"], group=G_Q, inline="t4")
en5  = input.bool(true,  "TF 5",  group=G_Q, inline="t5")
rawTf5 = input.string("4h", "", options=["1m","3m","5m","15m","30m","45m","90m","1h","2h","3h","4h","6h","7h","8h","12h","1D","1W","1M"], group=G_Q, inline="t5")
en6  = input.bool(true,  "TF 6",  group=G_Q, inline="t6")
rawTf6 = input.string("6h", "", options=["1m","3m","5m","15m","30m","45m","90m","1h","2h","3h","4h","6h","7h","8h","12h","1D","1W","1M"], group=G_Q, inline="t6")
en7  = input.bool(true,  "TF 7",  group=G_Q, inline="t7")
rawTf7 = input.string("7h", "", options=["1m","3m","5m","15m","30m","45m","90m","1h","2h","3h","4h","6h","7h","8h","12h","1D","1W","1M"], group=G_Q, inline="t7")
en8  = input.bool(true,  "TF 8",  group=G_Q, inline="t8")
rawTf8 = input.string("1D", "", options=["1m","3m","5m","15m","30m","45m","90m","1h","2h","3h","4h","6h","7h","8h","12h","1D","1W","1M"], group=G_Q, inline="t8")
en9  = input.bool(true,  "TF 9",  group=G_Q, inline="t9")
rawTf9 = input.string("1W", "", options=["1m","3m","5m","15m","30m","45m","90m","1h","2h","3h","4h","6h","7h","8h","12h","1D","1W","1M"], group=G_Q, inline="t9")
en10 = input.bool(true,  "TF 10", group=G_Q, inline="t10")
rawTf10 = input.string("1M", "", options=["1m","3m","5m","15m","30m","45m","90m","1h","2h","3h","4h","6h","7h","8h","12h","1D","1W","1M"], group=G_Q, inline="t10")

colBear = input.color(color.red,  "Bearish", group=G_V, inline="c")
colBull = input.color(color.lime, "Bullish", group=G_V, inline="c")
maxDraw = input.int(200, "Max lines / labels kept", minval=10, maxval=250, group=G_V)
showLbl = input.bool(true, "Show text", group=G_V)
mergeBars = input.int(4, "Merge text within N bars", minval=0, maxval=30, group=G_V, tooltip="Texts of the same side that land within N bars of each other are combined into ONE stacked block. Higher = cleaner chart.")
maxRows   = input.int(5, "Max rows per text block", minval=1, maxval=12, group=G_V)
const string G_N = "Display Names (optional short names)"
nm1 = input.string("", "Asset 1 name", group=G_N)
nm2 = input.string("", "Asset 2 name", group=G_N)
nm3 = input.string("", "Asset 3 name", group=G_N)
nm4 = input.string("", "Asset 4 name", group=G_N)

float atrV = ta.atr(14)

// ═══════════════════════════════════════════════════════════════
// 1. TYPES
// ═══════════════════════════════════════════════════════════════
type SwingState
    float mh  = na
    float ch  = na
    int   mhT = na
    float ml  = na
    float cl  = na
    int   mlT = na

type HtfAcc
    float runH  = na
    int   runHT = na
    float runL  = na
    int   runLT = na
    float curH  = na
    int   curHT = na
    float curL  = na
    int   curLT = na
    float prevH  = na
    int   prevHT = na
    float prevL  = na
    int   prevLT = na

// ═══════════════════════════════════════════════════════════════
// 2. HELPERS
// ═══════════════════════════════════════════════════════════════
var line[]   smtLines  = array.new<line>()
var bool[]   labelDir = array.new<bool>()
var string[] labelTf  = array.new<string>()   // timeframe each text block was created for
var string[] lineTf   = array.new<string>()   // timeframe each line belongs to
var string[] lineStyles = array.new<string>()   // parallel to smtLines: solid = SMT, dashed = SSMT
var label[] smtLabels = array.new<label>()

f_short(string s) =>
    parts = str.split(s, ":")
    string r = array.get(parts, array.size(parts) - 1)
    str.endswith(r, "USD") and str.length(r) > 3 ? str.substring(r, 0, str.length(r) - 3) : r

f_tfName(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string r = ""
    if sec < 86400
        int m = int(sec / 60)
        r := m % 60 == 0 ? str.tostring(int(m / 60)) + "h" : str.tostring(m) + "m"
    else if sec < 604800
        r := str.tostring(int(sec / 86400)) + "D"
    else if sec < 2592000
        r := str.tostring(int(sec / 604800)) + "W"
    else
        r := str.tostring(int(sec / 2592000)) + "M"
    r

f_tfStr(string s) =>
    int n = int(str.tonumber(str.substring(s, 0, str.length(s) - 1)))
    string suf = str.substring(s, str.length(s) - 1)
    suf == "m" ? str.tostring(n) : suf == "h" ? str.tostring(n * 60) : s

tf1  = f_tfStr(rawTf1)
tf2  = f_tfStr(rawTf2)
tf3  = f_tfStr(rawTf3)
tf4  = f_tfStr(rawTf4)
tf5  = f_tfStr(rawTf5)
tf6  = f_tfStr(rawTf6)
tf7  = f_tfStr(rawTf7)
tf8  = f_tfStr(rawTf8)
tf9  = f_tfStr(rawTf9)
tf10 = f_tfStr(rawTf10)

f_move(float curr, float prev, float tol) =>
    curr > prev + tol ? 1 : curr < prev - tol ? -1 : 0

f_div(int mMove, int cMove, bool inv, bool flip, int classic) =>
    int cm = inv ? -cMove : cMove
    mMove != 0 and cm != 0 and mMove * cm == -1 and (flip or mMove == classic)

f_draw(int x1, float y1, int x2, float y2, color c, string st, string tfTxt, string pair, bool above) =>
    // 1) line — skip if an identical one already exists (multiple assets, same anchors)
    bool dupLine = false
    int nl = array.size(smtLines)
    if nl > 0
        for i = math.max(0, nl - 40) to nl - 1
            line l0 = array.get(smtLines, i)
            if array.get(lineTf, i) == tfTxt and array.get(lineStyles, i) == st and line.get_x1(l0) == x1 and line.get_y1(l0) == y1 and line.get_x2(l0) == x2 and line.get_y2(l0) == y2
                dupLine := true
    if not dupLine
        ln = line.new(x1, y1, x2, y2, xloc=xloc.bar_time, color=c, style=st, width=1)
        array.push(smtLines, ln)
        array.push(lineStyles, st)
        array.push(lineTf, tfTxt)
        while array.size(smtLines) > maxDraw
            line.delete(array.shift(smtLines))
            array.shift(lineStyles)
            array.shift(lineTf)
    // 2) text — nearby same-side texts merge into ONE stacked block; same-TF pairs share a row
    if showLbl
        int   mx = x1 + int((x2 - x1) / 2)   // text is centered along the line, then pushed OFF the line (bearish above, bullish below)
        float my = (y1 + y2) / 2
        bool merged = false
        int nb = array.size(smtLabels)
        int radius = mergeBars * timeframe.in_seconds(timeframe.period) * 1000
        if nb > 0
            for i = math.max(0, nb - 40) to nb - 1
                label lb = array.get(smtLabels, i)
                bool exact = label.get_x(lb) == mx and label.get_y(lb) == my
                bool sameTfNear = array.get(labelTf, i) == tfTxt and math.abs(label.get_x(lb) - mx) <= radius and math.abs(label.get_y(lb) - my) <= atrV * 4
                if not merged and array.get(labelDir, i) == above and (exact or sameTfNear)
                    string[] rows = str.split(label.get_text(lb), "\n")
                    bool found = false
                    for r = 0 to array.size(rows) - 1
                        string row = array.get(rows, r)
                        if not found and str.startswith(row, tfTxt + " ")
                            if not str.contains(row + " ", " " + pair + " ")
                                array.set(rows, r, row + " " + pair)
                            found := true
                    if not found and array.size(rows) < maxRows
                        array.push(rows, tfTxt + " " + pair)
                    label.set_text(lb, array.join(rows, "\n"))
                    merged := true
        if not merged
            lb2 = label.new(mx, my, tfTxt + " " + pair, xloc=xloc.bar_time, style=above ? label.style_label_down : label.style_label_up,
                 color=color.new(c, 100), textcolor=c, size=size.tiny)
            array.push(smtLabels, lb2)
            array.push(labelDir, above)
            array.push(labelTf, tfTxt)
            while array.size(smtLabels) > maxDraw
                label.delete(array.shift(smtLabels))
                array.shift(labelDir)
                array.shift(labelTf)

f_swing(SwingState s, bool use, bool inv, float mPH, float mPL, float cPH, float cPL, int pT, float cTick, string nm) =>
    bool bear = false
    bool bull = false
    if use and barstate.isconfirmed
        float tolM = tolTicks * syminfo.mintick
        float tolC = tolTicks * cTick
        if not na(mPH) and not na(cPH)
            if not na(s.mh) and not na(s.ch)
                if f_div(f_move(mPH, s.mh, tolM), f_move(cPH, s.ch, tolC), inv, allowFlip, 1)
                    bear := true
                    f_draw(s.mhT, s.mh, pT, mPH, colBear, line.style_solid, f_tfName(timeframe.period), nm, true)
            s.mh := mPH
            s.ch := cPH
            s.mhT := pT
        if not na(mPL) and not na(cPL)
            if not na(s.ml) and not na(s.cl)
                if f_div(f_move(mPL, s.ml, tolM), f_move(cPL, s.cl, tolC), inv, allowFlip, -1)
                    bull := true
                    f_draw(s.mlT, s.ml, pT, mPL, colBull, line.style_solid, f_tfName(timeframe.period), nm, false)
            s.ml := mPL
            s.cl := cPL
            s.mlT := pT
    [bear, bull]

f_acc(HtfAcc a, float h, float l, bool newCandle) =>
    if barstate.isconfirmed and not na(h) and not na(l)
        if newCandle
            a.prevH := a.curH
            a.prevHT := a.curHT
            a.prevL := a.curL
            a.prevLT := a.curLT
            a.curH := a.runH
            a.curHT := a.runHT
            a.curL := a.runL
            a.curLT := a.runLT
            a.runH := h
            a.runHT := time
            a.runL := l
            a.runLT := time
        else
            if na(a.runH) or h > a.runH
                a.runH := h
                a.runHT := time
            if na(a.runL) or l < a.runL
                a.runL := l
                a.runLT := time

f_ssmt(HtfAcc m, HtfAcc c, bool use, bool inv, float cTick, string tfTxt, string pair) =>
    bool bear = false
    bool bull = false
    if use and barstate.isconfirmed and not na(m.prevH) and not na(c.prevH) and not na(m.curH) and not na(c.curH)
        float tolM = tolTicks * syminfo.mintick
        float tolC = tolTicks * cTick
        bool bearDiv = f_div(f_move(m.curH, m.prevH, tolM), f_move(c.curH, c.prevH, tolC), inv, allowFlip, 1)
        bool bullDiv = f_div(f_move(m.curL, m.prevL, tolM), f_move(c.curL, c.prevL, tolC), inv, allowFlip, -1)
        if bearDiv
            bear := true
            f_draw(m.prevHT, m.prevH, m.curHT, m.curH, colBear, line.style_solid, tfTxt, pair, true)
        else if bullDiv
            bull := true
            f_draw(m.prevLT, m.prevL, m.curLT, m.curL, colBull, line.style_solid, tfTxt, pair, false)
    [bear, bull]

// ═══════════════════════════════════════════════════════════════
// 3. DATA (1 tuple security call per asset)
// ═══════════════════════════════════════════════════════════════
f_get(string sym) =>
    request.security(sym, timeframe.period, [high, low, syminfo.mintick], barmerge.gaps_off, barmerge.lookahead_off)

[c1h, c1l, c1t] = f_get(sym1)
[c2h, c2l, c2t] = f_get(sym2)
[c3h, c3l, c3t] = f_get(sym3)
[c4h, c4l, c4t] = f_get(sym4)

n1 = nm1 != "" ? nm1 : f_short(sym1)
n2 = nm2 != "" ? nm2 : f_short(sym2)
n3 = nm3 != "" ? nm3 : f_short(sym3)
n4 = nm4 != "" ? nm4 : f_short(sym4)

// ═══════════════════════════════════════════════════════════════
// 4. SWING SMT
// ═══════════════════════════════════════════════════════════════
int chartSec = timeframe.in_seconds(timeframe.period)
bool swingTfOn = not swingOnlyTf or (en1 and timeframe.in_seconds(tf1) == chartSec) or (en2 and timeframe.in_seconds(tf2) == chartSec) or (en3 and timeframe.in_seconds(tf3) == chartSec) or (en4 and timeframe.in_seconds(tf4) == chartSec) or (en5 and timeframe.in_seconds(tf5) == chartSec) or (en6 and timeframe.in_seconds(tf6) == chartSec) or (en7 and timeframe.in_seconds(tf7) == chartSec) or (en8 and timeframe.in_seconds(tf8) == chartSec) or (en9 and timeframe.in_seconds(tf9) == chartSec) or (en10 and timeframe.in_seconds(tf10) == chartSec)

var SwingState sw1 = SwingState.new()
var SwingState sw2 = SwingState.new()
var SwingState sw3 = SwingState.new()
var SwingState sw4 = SwingState.new()

float mPH = ta.pivothigh(high, swingLeft, swingRight)
float mPL = ta.pivotlow(low,  swingLeft, swingRight)
int   pT  = time[swingRight]

[sb1, su1] = f_swing(sw1, showSwing and swingTfOn and use1, inv1, mPH, mPL, c1h[swingRight], c1l[swingRight], pT, c1t, n1)
[sb2, su2] = f_swing(sw2, showSwing and swingTfOn and use2, inv2, mPH, mPL, c2h[swingRight], c2l[swingRight], pT, c2t, n2)
[sb3, su3] = f_swing(sw3, showSwing and swingTfOn and use3, inv3, mPH, mPL, c3h[swingRight], c3l[swingRight], pT, c3t, n3)
[sb4, su4] = f_swing(sw4, showSwing and swingTfOn and use4, inv4, mPH, mPL, c4h[swingRight], c4l[swingRight], pT, c4t, n4)

// ═══════════════════════════════════════════════════════════════
// 5. MULTI-TIMEFRAME SSMT
//    Index layout: accs[tfIdx * 5 + k], k = 0 main, 1..4 assets
// ═══════════════════════════════════════════════════════════════
var HtfAcc[] accs = array.new<HtfAcc>()
var int[]    lastT = array.new<int>(10, na)
if barstate.isfirst
    for j = 0 to 49
        array.push(accs, HtfAcc.new())

tfs  = array.from(tf1, tf2, tf3, tf4, tf5, tf6, tf7, tf8, tf9, tf10)
ens  = array.from(en1, en2, en3, en4, en5, en6, en7, en8, en9, en10)
tms  = array.from(time(tf1), time(tf2), time(tf3), time(tf4), time(tf5), time(tf6), time(tf7), time(tf8), time(tf9), time(tf10))

useA  = array.from(use1, use2, use3, use4)
invA  = array.from(inv1, inv2, inv3, inv4)
tickA = array.from(c1t, c2t, c3t, c4t)
nameA = array.from(n1, n2, n3, n4)
hiA   = array.from(high, c1h, c2h, c3h, c4h)
loA   = array.from(low,  c1l, c2l, c3l, c4l)

bool ssBear = false
bool ssBull = false
string badTfs = ""

for i = 0 to 9
    string tf = array.get(tfs, i)
    bool valid = array.get(ens, i) and timeframe.in_seconds(tf) >= chartSec
    if array.get(ens, i) and not valid
        badTfs += f_tfName(tf) + " "
    int tNow  = array.get(tms, i)
    int tLast = array.get(lastT, i)
    bool closed = not na(tNow) and not na(tLast) and tNow != tLast
    if showSSMT and valid
        for k = 0 to 4
            f_acc(array.get(accs, i * 5 + k), array.get(hiA, k), array.get(loA, k), closed)
        for a = 0 to 3
            [b, u] = f_ssmt(array.get(accs, i * 5), array.get(accs, i * 5 + a + 1), closed and array.get(useA, a), array.get(invA, a), array.get(tickA, a), f_tfName(tf), array.get(nameA, a))
            ssBear := ssBear or b
            ssBull := ssBull or u
    if barstate.isconfirmed and not na(tNow)
        array.set(lastT, i, tNow)

// ═══════════════════════════════════════════════════════════════
// 6. STATUS + ALERTS
// ═══════════════════════════════════════════════════════════════
var table tbl = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(tbl, 0, 0, showSSMT and badTfs != "" ? "SSMT skipped (TF below chart TF): " + badTfs : "", text_color=color.orange, text_size=size.small)

alertcondition(sb1 or sb2 or sb3 or sb4, "Swing SMT Bearish", "Bearish Swing SMT on {{ticker}}")
alertcondition(su1 or su2 or su3 or su4, "Swing SMT Bullish", "Bullish Swing SMT on {{ticker}}")
alertcondition(ssBear, "SSMT Bearish", "Bearish SSMT on {{ticker}}")
alertcondition(ssBull, "SSMT Bullish", "Bullish SSMT on {{ticker}}")
