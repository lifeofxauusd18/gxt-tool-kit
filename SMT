sym2 = input.symbol("CBOT_MINI:YM1!", "", group=G_A, inline="a2")
inv2 = input.bool(false, "↕ Inverse", group=G_A, inline="a2")
use3 = input.bool(true,  "Asset 3", group=G_A, inline="a3")
sym3 = input.symbol("CME_MINI:RTY1!", "", group=G_A, inline="a3")
inv3 = input.bool(false, "↕ Inverse", group=G_A, inline="a3")
use4 = input.bool(true,  "Asset 4", group=G_A, inline="a4")
sym4 = input.symbol("TVC:DXY", "", group=G_A, inline="a4")
inv4 = input.bool(true,  "↕ Inverse", group=G_A, inline="a4")

