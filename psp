//@version=5
// ═════════════════════════════════════════════════════════════════════════════
// GxT PSP — PERFECT & VALID ONLY
//
// A PSP is drawn only if ALL of these hold:
//   1. Swing candle is a real swing extreme on the MAIN chart (strict anchor)
//   2. MIXED closure: >=1 real green body AND >=1 real red body across the assets
//      (dojis / tiny bodies don't count as a colour)
//   3. Confirmed: price breaks the swing candle's range after it closed
//   4. Never invalidated (any wick by default, or close-only) -> failed PSPs are
//      deleted from the chart, so what remains is valid
//   5. (optional, ON by default) a STRICT SMT exists at the same swing
//
// STRICT SMT: every enabled asset prints a confirmed pivot on the SAME candle;
//   at least one asset takes out its previous pivot (HH / LL) while at least one
//   FAILS to (LH / HL).
// ═════════════════════════════════════════════════════════════════════════════
indicator("GxT PSP — Perfect & Valid", shorttitle="PSP✓", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
g_sym = "Correlated Assets (main chart is always included)"
use_sym1  = input.bool(true, "Symbol 1", group=g_sym, inline="s1")
sym1_in   = input.symbol("OANDA:XAUEUR", "", group=g_sym, inline="s1")
use_sym2  = input.bool(true, "Symbol 2", group=g_sym, inline="s2")
sym2_in   = input.symbol("OANDA:XAUUSD", "", group=g_sym, inline="s2")
use_sym3  = input.bool(false, "Symbol 3", group=g_sym, inline="s3")
sym3_in   = input.symbol("OANDA:XAUGBP", "", group=g_sym, inline="s3")

g_eng = "PSP Engine (strict defaults)"
swing_len            = input.int(5, "Swing lookback (bars)", minval=1, group=g_eng, tooltip="Swing candle must be the highest high / lowest low of the last N bars. Higher = more significant swings.")
psp_require_break    = input.bool(true, "Require swing-candle range break (confirmation)", group=g_eng, tooltip="ON = PSP is confirmed only after price breaks the swing candle's range. OFF = Instant mode (fires on the next bar's open, less strict).")
psp_inval_close_only = input.bool(false, "Invalidate on CLOSE only (ignore wicks)", group=g_eng, tooltip="OFF (strict) = any wick beyond the swing level kills the PSP. ON = only a close beyond it does.")
psp_orgate_enabled   = input.bool(false, "OR-gate: swing on ANY asset registers a candidate", group=g_eng, tooltip="OFF (strict) = the MAIN chart must show the swing.")
min_body_pct         = input.float(20.0, "Min candle body (% of range) to count as a colour", minval=0, maxval=100, group=g_eng, tooltip="Candles with a smaller body are treated as dojis and do not count as red or green.")

g_val = "Validity Filters"
require_smt   = input.bool(true, "Require a STRICT SMT at the same swing", group=g_val, tooltip="ON = only PSPs backed by a strict SMT are drawn (PSP + SMT = Confluence). OFF = valid PSPs are drawn without it; those with SMT are starred.")
smt_right     = input.int(2, "SMT pivot confirmation bars (right)", minval=1, group=g_val, tooltip="Bars after the pivot needed to confirm it. SMT is therefore known this many bars after the swing.")
conf_window   = input.int(3, "PSP <-> SMT swing tolerance (bars)", minval=0, group=g_val)
failed_mode   = input.string("Delete (valid only)", "Failed PSPs", options=["Delete (valid only)", "Mark gray"], group=g_val, tooltip="A PSP is wrong when price takes out its swing level after it was confirmed.")
track_bars    = input.int(20, "Failure tracking window (bars)", minval=1, group=g_val)

g_vis = "Visuals"
psp_color    = input.color(color.new(color.orange, 60), "PSP line color", group=g_vis)
failed_color = input.color(color.new(color.gray, 55), "Failed PSP color (Mark gray mode)", group=g_vis)
max_psp_tags = input.int(10, "Max tags on chart", minval=1, maxval=200, group=g_vis)
show_labels  = input.bool(true, "Show PSP labels", group=g_vis)
show_smt     = input.bool(true, "Show strict SMT marks", group=g_vis)

// ─────────────────────────────────────────────────────────────────────────────
// CORRELATED ASSET DATA (same timeframe, no lookahead)
// ─────────────────────────────────────────────────────────────────────────────
s1 = use_sym1 ? sym1_in : syminfo.tickerid
s2 = use_sym2 ? sym2_in : syminfo.tickerid
s3 = use_sym3 ? sym3_in : syminfo.tickerid

[c1_o, c1_h, c1_l, c1_c] = request.security(s1, timeframe.period, [open, high, low, close], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
[c2_o, c2_h, c2_l, c2_c] = request.security(s2, timeframe.period, [open, high, low, close], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)
[c3_o, c3_h, c3_l, c3_c] = request.security(s3, timeframe.period, [open, high, low, close], barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)

// ─────────────────────────────────────────────────────────────────────────────
// SWING DETECTION — swing candle is bar [1] (last CLOSED candle)
// ─────────────────────────────────────────────────────────────────────────────
f_swing_hi(float h, int n) => h[1] > ta.highest(h, n)[2]
f_swing_lo(float l, int n) => l[1] < ta.lowest(l, n)[2]

sh_m = f_swing_hi(high, swing_len)
sh_1 = f_swing_hi(c1_h, swing_len)
sh_2 = f_swing_hi(c2_h, swing_len)
sh_3 = f_swing_hi(c3_h, swing_len)
sl_m = f_swing_lo(low,  swing_len)
sl_1 = f_swing_lo(c1_l, swing_len)
sl_2 = f_swing_lo(c2_l, swing_len)
sl_3 = f_swing_lo(c3_l, swing_len)

// ─────────────────────────────────────────────────────────────────────────────
// has_red AND has_grn GATE — real bodies only (doji-filtered), swing candle [1]
// ─────────────────────────────────────────────────────────────────────────────
f_red(float o, float c, float h, float l) => (o - c) > 0 and (o - c) >= (min_body_pct / 100.0) * (h - l)
f_grn(float o, float c, float h, float l) => (c - o) > 0 and (c - o) >= (min_body_pct / 100.0) * (h - l)

main_red = f_red(open[1], close[1], high[1], low[1])
main_grn = f_grn(open[1], close[1], high[1], low[1])
c1_red   = f_red(c1_o[1], c1_c[1], c1_h[1], c1_l[1])
c1_grn   = f_grn(c1_o[1], c1_c[1], c1_h[1], c1_l[1])
c2_red   = f_red(c2_o[1], c2_c[1], c2_h[1], c2_l[1])
c2_grn   = f_grn(c2_o[1], c2_c[1], c2_h[1], c2_l[1])
c3_red   = f_red(c3_o[1], c3_c[1], c3_h[1], c3_l[1])
c3_grn   = f_grn(c3_o[1], c3_c[1], c3_h[1], c3_l[1])

has_red = main_red or (use_sym1 and c1_red) or (use_sym2 and c2_red) or (use_sym3 and c3_red)
has_grn = main_grn or (use_sym1 and c1_grn) or (use_sym2 and c2_grn) or (use_sym3 and c3_grn)
mixed_closure = has_red and has_grn

// OR-gate anchoring
any_sh = sh_m or (use_sym1 and sh_1) or (use_sym2 and sh_2) or (use_sym3 and sh_3)
any_sl = sl_m or (use_sym1 and sl_1) or (use_sym2 and sl_2) or (use_sym3 and sl_3)
anchor_hi = psp_orgate_enabled ? any_sh : sh_m
anchor_lo = psp_orgate_enabled ? any_sl : sl_m

bear_trig = anchor_hi and mixed_closure
bull_trig = anchor_lo and mixed_closure

// ─────────────────────────────────────────────────────────────────────────────
// STRICT SMT — confirmed pivots on the SAME candle across every enabled asset.
//   Bearish SMT: one asset HH (takes previous pivot high), another LH (fails to).
//   Bullish SMT: one asset LL (takes previous pivot low),  another HL (fails to).
// ─────────────────────────────────────────────────────────────────────────────
f_piv_hi(float p) =>
    var float cur = na
    bool has = not na(p)
    bool hh = has and not na(cur) and p > cur
    bool lh = has and not na(cur) and p < cur
    if has
        cur := p
    [has, hh, lh]

f_piv_lo(float p) =>
    var float cur = na
    bool has = not na(p)
    bool ll = has and not na(cur) and p < cur
    bool hl = has and not na(cur) and p > cur
    if has
        cur := p
    [has, ll, hl]

[phas_m, hh_m, lh_m] = f_piv_hi(ta.pivothigh(high, swing_len, smt_right))
[phas_1, hh_1, lh_1] = f_piv_hi(ta.pivothigh(c1_h, swing_len, smt_right))
[phas_2, hh_2, lh_2] = f_piv_hi(ta.pivothigh(c2_h, swing_len, smt_right))
[phas_3, hh_3, lh_3] = f_piv_hi(ta.pivothigh(c3_h, swing_len, smt_right))
[lhas_m, ll_m, hl_m] = f_piv_lo(ta.pivotlow(low, swing_len, smt_right))
[lhas_1, ll_1, hl_1] = f_piv_lo(ta.pivotlow(c1_l, swing_len, smt_right))
[lhas_2, ll_2, hl_2] = f_piv_lo(ta.pivotlow(c2_l, swing_len, smt_right))
[lhas_3, ll_3, hl_3] = f_piv_lo(ta.pivotlow(c3_l, swing_len, smt_right))

all_phas = phas_m and (not use_sym1 or phas_1) and (not use_sym2 or phas_2) and (not use_sym3 or phas_3)
all_lhas = lhas_m and (not use_sym1 or lhas_1) and (not use_sym2 or lhas_2) and (not use_sym3 or lhas_3)

any_hh = hh_m or (use_sym1 and hh_1) or (use_sym2 and hh_2) or (use_sym3 and hh_3)
any_lh = lh_m or (use_sym1 and lh_1) or (use_sym2 and lh_2) or (use_sym3 and lh_3)
any_ll = ll_m or (use_sym1 and ll_1) or (use_sym2 and ll_2) or (use_sym3 and ll_3)
any_hl = hl_m or (use_sym1 and hl_1) or (use_sym2 and hl_2) or (use_sym3 and hl_3)

smt_bear = all_phas and any_hh and any_lh
smt_bull = all_lhas and any_ll and any_hl

var int smt_bear_sw = na   // swing (pivot) bar of the latest strict bearish SMT
var int smt_bull_sw = na
if smt_bear
    smt_bear_sw := bar_index - smt_right
if smt_bull
    smt_bull_sw := bar_index - smt_right

var array<label> smt_labels = array.new<label>()
if show_smt and smt_bear
    array.push(smt_labels, label.new(bar_index - smt_right, high[smt_right], "SMT", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.aqua, 10), textcolor=color.black, size=size.tiny))
if show_smt and smt_bull
    array.push(smt_labels, label.new(bar_index - smt_right, low[smt_right], "SMT", xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.aqua, 10), textcolor=color.black, size=size.tiny))
while array.size(smt_labels) > max_psp_tags
    label.delete(array.shift(smt_labels))

// ─────────────────────────────────────────────────────────────────────────────
// CANDIDATE REGISTERS (snapshot of the swing candle — values shift next bar)
// ─────────────────────────────────────────────────────────────────────────────
var bool  b_act = false
var float b_hi  = na
var float b_lo  = na
var int   b_bar = na

var bool  u_act = false
var float u_hi  = na
var float u_lo  = na
var int   u_bar = na

bool  bear_fire = false
bool  bull_fire = false
int   bear_f_bar = na
int   bull_f_bar = na
float bear_f_hi = na
float bear_f_lo = na
float bull_f_hi = na
float bull_f_lo = na

// ─────────────────────────────────────────────────────────────────────────────
// PSP ENGINE
// EXCEPTION: intentionally NOT gated on barstate.isconfirmed (no one-bar lag).
// ─────────────────────────────────────────────────────────────────────────────
if not psp_require_break
    if bear_trig
        bear_fire  := true
        bear_f_bar := bar_index - 1
        bear_f_hi  := high[1]
        bear_f_lo  := low[1]
    if bull_trig
        bull_fire  := true
        bull_f_bar := bar_index - 1
        bull_f_hi  := high[1]
        bull_f_lo  := low[1]
else
    if bear_trig
        psp_is_new_peak = not b_act or high[1] >= b_hi
        if psp_is_new_peak
            b_act := true
            b_hi  := high[1]
            b_lo  := low[1]
            b_bar := bar_index - 1
    if bull_trig
        psp_is_new_trough = not u_act or low[1] <= u_lo
        if psp_is_new_trough
            u_act := true
            u_hi  := high[1]
            u_lo  := low[1]
            u_bar := bar_index - 1

    if b_act
        b_inval = psp_inval_close_only ? close > b_hi : high > b_hi
        if b_inval
            b_act := false
        else if low < b_lo
            bear_fire  := true
            bear_f_bar := b_bar
            bear_f_hi  := b_hi
            bear_f_lo  := b_lo
            b_act := false

    if u_act
        u_inval = psp_inval_close_only ? close < u_lo : low < u_lo
        if u_inval
            u_act := false
        else if high > u_hi
            bull_fire  := true
            bull_f_bar := u_bar
            bull_f_hi  := u_hi
            bull_f_lo  := u_lo
            u_act := false

// ─────────────────────────────────────────────────────────────────────────────
// SMT MATCHING — a confirmed PSP waits (briefly) for a strict SMT at the same swing.
// The SMT is only known `smt_right` bars after its pivot, so the PSP is held until
// then. If SMT is required and none matches in time, the PSP is dropped.
// ─────────────────────────────────────────────────────────────────────────────
var bool  pb_act = false
var int   pb_bar = na
var float pb_hi  = na
var float pb_lo  = na
var int   pb_fire = na
var bool  pu_act = false
var int   pu_bar = na
var float pu_hi  = na
var float pu_lo  = na
var int   pu_fire = na

if bear_fire
    pb_act  := true
    pb_bar  := bear_f_bar
    pb_hi   := bear_f_hi
    pb_lo   := bear_f_lo
    pb_fire := bar_index
if bull_fire
    pu_act  := true
    pu_bar  := bull_f_bar
    pu_hi   := bull_f_hi
    pu_lo   := bull_f_lo
    pu_fire := bar_index

bool  bear_ready = false
bool  bull_ready = false
bool  bear_conf  = false
bool  bull_conf  = false
int   rd_b_bar = na
float rd_b_hi  = na
float rd_b_lo  = na
int   rd_u_bar = na
float rd_u_hi  = na
float rd_u_lo  = na

if pb_act
    bool m = not na(smt_bear_sw) and math.abs(pb_bar - smt_bear_sw) <= conf_window
    if m or not require_smt
        bear_ready := true
        bear_conf  := m
        rd_b_bar := pb_bar
        rd_b_hi  := pb_hi
        rd_b_lo  := pb_lo
        pb_act := false
    else if bar_index - pb_fire > conf_window + smt_right + 1
        pb_act := false
if pu_act
    bool m = not na(smt_bull_sw) and math.abs(pu_bar - smt_bull_sw) <= conf_window
    if m or not require_smt
        bull_ready := true
        bull_conf  := m
        rd_u_bar := pu_bar
        rd_u_hi  := pu_hi
        rd_u_lo  := pu_lo
        pu_act := false
    else if bar_index - pu_fire > conf_window + smt_right + 1
        pu_act := false

// ─────────────────────────────────────────────────────────────────────────────
// VISUALS + VALIDITY TRACKING (failed PSPs are deleted or greyed)
// ─────────────────────────────────────────────────────────────────────────────
type PspRec
    line  ln
    label lb
    float lvl
    bool  is_bear
    int   fire_bar
    bool  active

var array<PspRec> psp_recs = array.new<PspRec>()
bool psp_failed_bear = false
bool psp_failed_bull = false

f_make_rec(int bar, float lo, float hi, bool is_bear, bool starred) =>
    line ln = line.new(bar, lo, bar, hi, xloc=xloc.bar_index, extend=extend.none, color=psp_color, width=6)
    label lb = na
    if show_labels
        lb := label.new(bar, is_bear ? hi : lo, starred ? "PSP ⭐" : "PSP", xloc=xloc.bar_index, style=is_bear ? label.style_label_down : label.style_label_up, color=is_bear ? color.new(color.red, 20) : color.new(color.green, 20), textcolor=color.white, size=size.tiny)
    PspRec.new(ln, lb, is_bear ? hi : lo, is_bear, bar_index, true)

if bear_ready
    psp_recs.push(f_make_rec(rd_b_bar, rd_b_lo, rd_b_hi, true, bear_conf))
if bull_ready
    psp_recs.push(f_make_rec(rd_u_bar, rd_u_lo, rd_u_hi, false, bull_conf))

if psp_recs.size() > 0
    for i = 0 to psp_recs.size() - 1
        PspRec r = psp_recs.get(i)
        if r.active
            bool failed_now = false
            if r.is_bear
                failed_now := psp_inval_close_only ? (barstate.isconfirmed and close > r.lvl) : high > r.lvl
            else
                failed_now := psp_inval_close_only ? (barstate.isconfirmed and close < r.lvl) : low < r.lvl
            if failed_now
                r.active := false
                if r.is_bear
                    psp_failed_bear := true
                else
                    psp_failed_bull := true
                if failed_mode == "Delete (valid only)"
                    if not na(r.ln)
                        line.delete(r.ln)
                    if not na(r.lb)
                        label.delete(r.lb)
                    r.ln := na
                    r.lb := na
                else
                    if not na(r.ln)
                        line.set_color(r.ln, failed_color)
                    if not na(r.lb)
                        label.set_text(r.lb, "PSP ✗")
                        label.set_color(r.lb, color.new(color.gray, 20))
            else if bar_index - r.fire_bar > track_bars
                r.active := false   // held through the window = valid

while psp_recs.size() > max_psp_tags
    PspRec old = psp_recs.shift()
    if not na(old.ln)
        line.delete(old.ln)
    if not na(old.lb)
        label.delete(old.lb)

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(bear_ready, "Bearish PSP (valid)", "Valid Bearish PSP on {{ticker}} {{interval}}")
alertcondition(bull_ready, "Bullish PSP (valid)", "Valid Bullish PSP on {{ticker}} {{interval}}")
alertcondition(bear_ready and bear_conf, "Bearish PSP + SMT", "Bearish PSP + strict SMT on {{ticker}} {{interval}}")
alertcondition(bull_ready and bull_conf, "Bullish PSP + SMT", "Bullish PSP + strict SMT on {{ticker}} {{interval}}")
alertcondition(psp_failed_bear, "Failed Bearish PSP", "Bearish PSP FAILED on {{ticker}} {{interval}}")
alertcondition(psp_failed_bull, "Failed Bullish PSP", "Bullish PSP FAILED on {{ticker}} {{interval}}")
