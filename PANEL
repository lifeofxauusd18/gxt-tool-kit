f_tfMap(string s) =>
    switch s
        '15m' => '15'
        '30m' => '30'
        '1H'  => '60'
        '90m' => '90'
        '4H'  => '240'
        '6H'  => '360'
        '7H'  => '420'
        '1D'  => 'D'
        '1W'  => 'W'
        =>       '60'

