    if htf1.settings.show and htf1.candles.size() > 0
        candleYHii = htf1.candles.CandleSetHigh(candleYHi)
        candleYHi := candleYHii
        candleYLo := math.min(candleYLo, htf1.candles.CandleSetLow(candleYHi))
    if htf2.settings.show and htf2.candles.size() > 0
        candleYHii = htf2.candles.CandleSetHigh(candleYHi)
        candleYHi := candleYHii
        candleYLo := math.min(candleYLo, htf2.candles.CandleSetLow(candleYHi))
