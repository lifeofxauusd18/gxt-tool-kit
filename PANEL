    htf1.Monitor().Update(offset).FindImbalance()
    cnt += 1
    htf1_end := offset + htf1.candles.size() * settings.width + (htf1.candles.size() > 0 ? (htf1.candles.size() - 1) * settings.buffer : 0)
    offset := offset + (cnt > 0 ? htf1.candles.size() * settings.width + (htf1.candles.size() > 0 ? (htf1.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
if htf2.settings.show and ValidTimeframe(htf2.settings.htf) and cnt < last
    htf2.UpdateTime(offset)
    htf2.Monitor().Update(offset).FindImbalance()
    cnt += 1
    htf2_end := offset + htf2.candles.size() * settings.width + (htf2.candles.size() > 0 ? (htf2.candles.size() - 1) * settings.buffer : 0)
